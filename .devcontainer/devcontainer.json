{
  "name": "Account Manager",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && cd frontend && npm install && npm run build",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "Account Manager",
      "onAutoForward": "openPreview"
    }
  },
  "postStartCommand": "echo 'Run: python app.py' "
}
